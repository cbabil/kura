# Kernel (signed by Debian, so Secure Boot works)
linux-image-amd64

# UEFI boot chain: create-image.sh copies the signed shim and GRUB onto the
# EFI partition (no grub-install, no firmware boot entry)
shim-signed
grub-efi-amd64-signed

# Firmware for real hardware (non-free-firmware, scripts/x86_64/configure-repos.sh):
# Intel Wi-Fi/Bluetooth, Realtek network, Intel graphics and others
firmware-iwlwifi
firmware-realtek
firmware-misc-nonfree
intel-microcode
amd64-microcode

# Cloud/VM support
qemu-guest-agent

# NOTE: Docker is baked into every image (see packages-common.list).

# Boot splash (theme kura, overlay/x86_64/usr/share/plymouth/themes/kura);
# Plymouth's initramfs hook copies fontconfig's files for any graphical theme
plymouth
fontconfig
