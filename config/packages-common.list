# Core system
systemd
systemd-sysv
bash
locales
ca-certificates
util-linux
gnupg
sudo

# JSON parsing (for os-config and os-security shell scripts)
jq

# Security
auditd

# Containers (from Docker's APT repo, added for every target by build.sh).
# Baked in so first boot works offline; Tomo runs apps with docker compose.
docker-ce
docker-ce-cli
containerd.io
docker-compose-plugin

# Tomo platform dependencies (the Tomo .deb itself is installed separately)
nodejs
git
openssl

# Grow the root partition on first boot (growpart)
cloud-guest-utils

# Networking
network-manager
openssh-server
iptables
iproute2

# Utilities (unzip needed for Bun binary extraction)
unzip
htop
nano
curl
less
ncurses-term
