# Core system
systemd
systemd-sysv
bash
locales
ca-certificates
util-linux
gnupg
sudo

# JSON parsing (for os-config and os-security shell scripts)
jq

# Security
auditd
# Security updates install themselves (scripts/common/auto-updates.sh); the
# clock must be right for TLS and APT
unattended-upgrades
systemd-timesyncd

# Containers (from Docker's APT repo, added for every target by build.sh).
# Baked in so containers can run without first installing Docker.
docker-ce
docker-ce-cli
containerd.io
docker-compose-plugin

openssl

# First-boot setup from the imager: time zones, console keyboard layout
tzdata
console-setup

# Grow the root partition on first boot (growpart)
cloud-guest-utils

# Networking
network-manager
openssh-server
iptables
iproute2

# Utilities
htop
nano
curl
less
ncurses-term
