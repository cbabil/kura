[Unit]
Description=__BRAND_NAME__ Configuration Manager
After=network-online.target
Before=__BRAND__-supervisor.service

[Service]
Type=simple
ExecStart=/usr/bin/__BRAND__-config
Restart=on-failure
RestartSec=30
ProtectHome=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
