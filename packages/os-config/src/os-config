#!/bin/bash
# __BRAND__-config — device configuration manager
# Reads /etc/__BRAND__/config.json and applies network + hostname settings.

set -euo pipefail

CONFIG_PATH="/etc/__BRAND__/config.json"
NM_CONN_DIR="/etc/NetworkManager/system-connections"
HOSTS_PATH="/etc/hosts"
SAFE_SSID_RE='^[a-zA-Z0-9][a-zA-Z0-9 _.-]*$'

log_info()    { echo "INFO:  __BRAND__-config: $*"; }
log_warning() { echo "WARNING: __BRAND__-config: $*" >&2; }
log_error()   { echo "ERROR: __BRAND__-config: $*" >&2; }

setup_wifi() {
    local wifi_enabled
    wifi_enabled=$(jq -r '.networkConfig.wifi.enable // false' "${CONFIG_PATH}")
    [[ "${wifi_enabled}" == "true" ]] || return 0

    local iface count
    iface=$(jq -r '.networkConfig.wifi.defaultInterface // "wlan0"' "${CONFIG_PATH}")
    count=$(jq '.networkConfig.wifi.networks | length' "${CONFIG_PATH}" 2>/dev/null)
    [[ -n "${count}" ]] && [[ "${count}" -gt 0 ]] || return 0

    local i ssid psk hidden conn_file tmp changed=0
    for ((i = 0; i < count; i++)); do
        ssid=$(jq -r ".networkConfig.wifi.networks[${i}].ssid // empty" "${CONFIG_PATH}")
        psk=$(jq -r ".networkConfig.wifi.networks[${i}].psk // empty" "${CONFIG_PATH}")
        hidden=$(jq -r ".networkConfig.wifi.networks[${i}].hidden == true" "${CONFIG_PATH}")

        if [[ -z "${ssid}" ]] || ! [[ "${ssid}" =~ ${SAFE_SSID_RE} ]]; then
            log_warning "Skipping invalid SSID: '${ssid}'"
            continue
        fi

        conn_file="${NM_CONN_DIR}/${ssid}.nmconnection"
        tmp="${conn_file}.new"
        write_connection "${ssid}" "${psk}" "${hidden}" "${iface}" > "${tmp}"
        chmod 0600 "${tmp}"
        if cmp -s "${tmp}" "${conn_file}"; then
            rm -f "${tmp}"
        else
            mv "${tmp}" "${conn_file}"
            changed=1
        fi
    done
    # NetworkManager reads connection files at start only
    if [[ "${changed}" -eq 1 ]]; then
        nmcli connection reload || log_warning "NetworkManager did not reload its connections"
    fi
}

# keyfile_escape <value>: GKeyFile escaping (NetworkManager decodes \\ and
# \s, and drops spaces around the value)
keyfile_escape() {
    local v="${1//\\/\\\\}"
    [[ "${v}" == " "* ]] && v="\\s${v:1}"
    [[ "${v}" == *" " ]] && v="${v%?}\\s"
    printf '%s' "${v}"
}

# write_connection <ssid> <psk> <hidden:true|false> <iface>: NetworkManager keyfile
write_connection() {
    local hidden=""
    [[ "$3" == "true" ]] && hidden=$'\nhidden=true'
    cat <<NMEOF
[connection]
id=$1
type=wifi
interface-name=$4

[wifi]
mode=infrastructure
ssid=$1${hidden}

[wifi-security]
key-mgmt=wpa-psk
psk=$(keyfile_escape "$2")

[ipv4]
method=auto

[ipv6]
method=auto
NMEOF
}

apply_hostname() {
    local desired current
    desired=$(jq -r '.hostname // empty' "${CONFIG_PATH}")
    [[ -n "${desired}" ]] || return 0

    current=$(hostname)
    [[ "${current}" != "${desired}" ]] || return 0
    if ! hostnamectl set-hostname "${desired}" 2>/dev/null; then
        log_warning "Failed to set hostname to ${desired}"
        return 0
    fi
    log_info "Hostname set to ${desired}"
    # The name resolves to this machine through its 127.0.1.1 entry
    local hosts
    hosts=$(awk -v h="${desired}" '$1 == "127.0.1.1" { print "127.0.1.1\t" h; next } { print }' \
        "${HOSTS_PATH}") && printf '%s\n' "${hosts}" > "${HOSTS_PATH}.new" &&
        mv "${HOSTS_PATH}.new" "${HOSTS_PATH}"
}

apply_config() {
    if [[ ! -f "${CONFIG_PATH}" ]]; then
        log_error "Config not found: ${CONFIG_PATH}"
        return 1
    fi

    setup_wifi
    apply_hostname
}

# ---- Main loop ----
while true; do
    apply_config || log_error "Configuration cycle failed"
    sleep 300
done
