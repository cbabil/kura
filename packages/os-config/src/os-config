#!/bin/bash
# __BRAND__-config — device configuration manager
# Reads /etc/__BRAND__/config.json and applies network + hostname settings:
# Wi-Fi networks, a static Ethernet address, the host name.

set -euo pipefail

CONFIG_PATH="/etc/__BRAND__/config.json"
NM_CONN_DIR="/etc/NetworkManager/system-connections"
HOSTS_PATH="/etc/hosts"
HOSTNAME_PATH="/etc/hostname"
SAFE_SSID_RE='^[a-zA-Z0-9][a-zA-Z0-9 _.-]*$'

log_info()    { echo "INFO:  __BRAND__-config: $*"; }
log_warning() { echo "WARNING: __BRAND__-config: $*" >&2; }
log_error()   { echo "ERROR: __BRAND__-config: $*" >&2; }

setup_wifi() {
    local wifi_enabled
    wifi_enabled=$(jq -r '.networkConfig.wifi.enable // false' "${CONFIG_PATH}")
    [[ "${wifi_enabled}" == "true" ]] || return 0

    local iface count
    iface=$(jq -r '.networkConfig.wifi.defaultInterface // empty' "${CONFIG_PATH}")
    count=$(jq '.networkConfig.wifi.networks | length' "${CONFIG_PATH}" 2>/dev/null)
    [[ -n "${count}" ]] && [[ "${count}" -gt 0 ]] || return 0

    local i ssid psk hidden conn_file tmp changed=0
    for ((i = 0; i < count; i++)); do
        ssid=$(jq -r ".networkConfig.wifi.networks[${i}].ssid // empty" "${CONFIG_PATH}")
        psk=$(jq -r ".networkConfig.wifi.networks[${i}].psk // empty" "${CONFIG_PATH}")
        hidden=$(jq -r ".networkConfig.wifi.networks[${i}].hidden == true" "${CONFIG_PATH}")

        if [[ -z "${ssid}" ]] || ! [[ "${ssid}" =~ ${SAFE_SSID_RE} ]]; then
            log_warning "Skipping invalid SSID: '${ssid}'"
            continue
        fi

        conn_file="${NM_CONN_DIR}/${ssid}.nmconnection"
        tmp="${conn_file}.new"
        write_connection "${ssid}" "${psk}" "${hidden}" "${iface}" > "${tmp}"
        chmod 0600 "${tmp}"
        if cmp -s "${tmp}" "${conn_file}"; then
            rm -f "${tmp}"
        else
            mv "${tmp}" "${conn_file}"
            changed=1
        fi
    done
    # NetworkManager reads connection files at start only
    if [[ "${changed}" -eq 1 ]]; then
        nmcli connection reload || log_warning "NetworkManager did not reload its connections"
    fi
}

# keyfile_escape <value>: GKeyFile escaping (NetworkManager decodes \\ and
# \s, and drops spaces around the value)
keyfile_escape() {
    local v="${1//\\/\\\\}"
    [[ "${v}" == " "* ]] && v="\\s${v:1}"
    [[ "${v}" == *" " ]] && v="${v%?}\\s"
    printf '%s' "${v}"
}

# write_connection <ssid> <psk> <hidden:true|false> <iface|"">: NetworkManager
# keyfile. With no interface, any Wi-Fi device can use it (names differ by
# hardware: wlan0 on a Pi, wlp2s0 on a PC).
write_connection() {
    local hidden="" iface=""
    [[ "$3" == "true" ]] && hidden=$'\nhidden=true'
    [[ -n "$4" ]] && iface=$'\ninterface-name='"$4"
    cat <<NMEOF
[connection]
id=$1
type=wifi${iface}

[wifi]
mode=infrastructure
ssid=$1${hidden}

[wifi-security]
key-mgmt=wpa-psk
psk=$(keyfile_escape "$2")

[ipv4]
method=auto

[ipv6]
method=auto
NMEOF
}

# The Ethernet address (Settings, ADR-029): once config.json has asked for a
# "manual" one, Kura keeps one NetworkManager connection for any Ethernet
# device, with that address or, back on "auto", the network's. One Ethernet
# port is assumed; with two, NetworkManager picks.
IPV4_RE='^([0-9]{1,3}\.){3}[0-9]{1,3}$'
setup_ethernet() {
    local conn="${NM_CONN_DIR}/__BRAND__-ethernet.nmconnection" method address gateway dns ipv4 tmp
    method=$(jq -r '.networkConfig.ethernet.ipv4.method // "auto"' "${CONFIG_PATH}")
    if [[ "${method}" != "manual" ]]; then
        # Never given an address by Kura: NetworkManager's own connection stays.
        # Given one before: Kura's connection stays and asks the network, since
        # NetworkManager makes its own only for a device that has none.
        [[ -e "${conn}" ]] || return 0
        ipv4="method=auto"
    else
        address=$(jq -r '.networkConfig.ethernet.ipv4.address // empty' "${CONFIG_PATH}")
        gateway=$(jq -r '.networkConfig.ethernet.ipv4.gateway // empty' "${CONFIG_PATH}")
        dns=$(jq -r '(.networkConfig.ethernet.ipv4.dns // []) | map(. + ";") | join("")' "${CONFIG_PATH}")
        if ! [[ "${address%/*}" =~ ${IPV4_RE} ]] || ! [[ "${address##*/}" =~ ^[0-9]{1,2}$ ]] ||
            ! [[ "${gateway}" =~ ${IPV4_RE} ]] || ! [[ "${dns}" =~ ^([0-9.]+\;)*$ ]]; then
            log_warning "Skipping an Ethernet address that is not one"
            return 0
        fi
        ipv4="method=manual"$'\n'"address1=${address},${gateway}"$'\n'"dns=${dns}"
    fi
    tmp="${conn}.new"
    (umask 077 && cat > "${tmp}") <<NMEOF
[connection]
id=__BRAND__-ethernet
type=ethernet
autoconnect-priority=10

[ipv4]
${ipv4}

[ipv6]
method=auto
NMEOF
    if cmp -s "${tmp}" "${conn}"; then
        rm -f "${tmp}"
    else
        mv "${tmp}" "${conn}"
        nmcli connection reload || log_warning "NetworkManager did not reload its connections"
        nmcli connection up __BRAND__-ethernet || log_warning "The Ethernet address was not applied yet"
    fi
}

apply_hostname() {
    local desired current
    desired=$(jq -r '.hostname // empty' "${CONFIG_PATH}")
    [[ -n "${desired}" ]] || return 0

    current=$(hostname)
    [[ "${current}" != "${desired}" ]] || return 0
    # hostname(1) and /etc/hostname, not hostnamectl: the image has no D-Bus
    if ! printf '%s\n' "${desired}" > "${HOSTNAME_PATH}" || ! hostname "${desired}"; then
        log_warning "Failed to set hostname to ${desired}"
        return 0
    fi
    log_info "Hostname set to ${desired}"
    # <host>.local follows (ADR-030); without avahi this does nothing
    systemctl try-restart avahi-daemon.service 2>/dev/null || true
    # The name resolves to this machine through its 127.0.1.1 entry
    local hosts
    hosts=$(awk -v h="${desired}" '$1 == "127.0.1.1" { print "127.0.1.1\t" h; next } { print }' \
        "${HOSTS_PATH}") && printf '%s\n' "${hosts}" > "${HOSTS_PATH}.new" &&
        mv "${HOSTS_PATH}.new" "${HOSTS_PATH}"
}

apply_config() {
    if [[ ! -f "${CONFIG_PATH}" ]]; then
        log_error "Config not found: ${CONFIG_PATH}"
        return 1
    fi

    setup_wifi
    setup_ethernet
    apply_hostname
}

# ---- Main loop ----
while true; do
    apply_config || log_error "Configuration cycle failed"
    sleep 300
done
