[Unit]
Description=__BRAND_NAME__ Security Hardening
DefaultDependencies=no
Before=sysinit.target
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/__BRAND__-security
PrivateTmp=yes
ProtectHome=yes
ProtectKernelLogs=yes
LockPersonality=yes

[Install]
WantedBy=sysinit.target
