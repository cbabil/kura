{
    "secure_boot": {
        "enabled": true,
        "verify_kernel": true,
        "verify_initramfs": true
    },
    "container_security": {
        "verify_signatures": true,
        "allowed_registries": [
            "registry.stratura.io",
            "docker.io"
        ],
        "seccomp_profile": "default"
    },
    "network_security": {
        "api_whitelist": [
            "api.stratura.io",
            "updates.stratura.io"
        ],
        "firewall_preset": "strict",
        "vpn_required": false
    },
    "update_security": {
        "verify_signatures": true,
        "require_chain_of_trust": true,
        "rollback_protection": true
    }
}
