<?xml version="1.0" standalone="no"?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- __BRAND_NAME__ Desktop, announced on the local network (ADR-030) -->
<service-group>
  <name replace-wildcards="yes">__BRAND_NAME__ Desktop on %h</name>
  <service>
    <type>_https._tcp</type>
    <port>443</port>
  </service>
</service-group>
