{
  "name": "os-supervisor",
  "version": "1.0.0",
  "description": "Device supervisor — container lifecycle, monitoring, and OTA updates",
  "main": "src/index.js",
  "scripts": {
    "start": "bun src/index.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:coverage": "jest --forceExit --detectOpenHandles --coverage"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "trustedDependencies": [],
  "dependencies": {
    "dockerode": "^4.0.0",
    "node-cron": "^3.0.3",
    "pino": "^8.17.0",
    "proper-lockfile": "^4.1.2",
    "systeminformation": "^5.21.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "pino-pretty": "^10.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
