[Unit]
Description=straturaOS Update Client
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/update-client
Restart=always
RestartSec=10
Environment=DOCKER_HOST=unix:///var/run/docker.sock

# Security hardening
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadOnlyPaths=/etc
ReadWritePaths=/var/lib/straturaOS

[Install]
WantedBy=multi-user.target 