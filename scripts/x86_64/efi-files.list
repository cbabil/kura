# <file in the rootfs> <file on the EFI partition>, GRUB before shim: a shim
# update never runs ahead of the GRUB it loads. Read by pc-image.sh (build)
# and sync-efi.sh (on the device, after every APT run).
usr/lib/grub/x86_64-efi-signed/grubx64.efi.signed EFI/BOOT/grubx64.efi
usr/lib/shim/shimx64.efi.signed EFI/BOOT/BOOTX64.EFI
# GRUB's menu in Kura's look (pc_grub_look in pc-image.sh); unicode.pf2 is
# grub-common's
usr/share/grub/unicode.pf2 EFI/debian/fonts/unicode.pf2
usr/share/grub/themes/kura/theme.txt EFI/debian/themes/kura/theme.txt
usr/share/grub/themes/kura/select_nw.png EFI/debian/themes/kura/select_nw.png
usr/share/grub/themes/kura/select_n.png EFI/debian/themes/kura/select_n.png
usr/share/grub/themes/kura/select_ne.png EFI/debian/themes/kura/select_ne.png
usr/share/grub/themes/kura/select_w.png EFI/debian/themes/kura/select_w.png
usr/share/grub/themes/kura/select_c.png EFI/debian/themes/kura/select_c.png
usr/share/grub/themes/kura/select_e.png EFI/debian/themes/kura/select_e.png
usr/share/grub/themes/kura/select_sw.png EFI/debian/themes/kura/select_sw.png
usr/share/grub/themes/kura/select_s.png EFI/debian/themes/kura/select_s.png
usr/share/grub/themes/kura/select_se.png EFI/debian/themes/kura/select_se.png
