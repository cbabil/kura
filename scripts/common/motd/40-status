#!/bin/bash
# 40-status — Service status display

# Source brand.env for runtime brand discovery
BRAND_ENV="/etc/falken/brand.env"
if [ -f "${BRAND_ENV}" ]; then
    . "${BRAND_ENV}"
fi

# Brand color
_c="${BRAND_COLOR:-#33ff00}"
C=$(printf '\033[38;2;%d;%d;%dm' "0x${_c:1:2}" "0x${_c:3:2}" "0x${_c:5:2}")
G="${C}"                   # same brand color for active/running
W=$'\033[1;37m'            # bold white    — key values
w=$'\033[0;37m'            # dim white     — body text, dots
r=$'\033[1;31m'            # bold red      — stopped, failed
R=$'\033[0m'               # reset

# Fallback must match DEFAULT_BRAND in scripts/common/brand-defaults.sh
BP="${BRAND_PREFIX:-falken}"

DIV="$(printf '\xe2\x94\x80%.0s' {1..33})"  # ─ repeated 33 times

# ---- Services ----
SERVICES=(${BP}-supervisor docker NetworkManager sshd)

printf "  %s\n" "${C}Services${R}"
printf "  %s\n" "${w}${DIV}${R}"

for svc in "${SERVICES[@]}"; do
    state=$(timeout 2 systemctl is-active "$svc" 2>/dev/null) || true
    [ -z "$state" ] && state="unknown"
    dots=$(printf '%*s' $((24 - ${#svc})) '' | tr ' ' '.')
    case "$state" in
        active)
            printf "  ${W}%s ${w}%s ${G}%s${R}\n" "$svc" "$dots" "$state"
            ;;
        *)
            printf "  ${W}%s ${w}%s ${r}%s${R}\n" "$svc" "$dots" "$state"
            ;;
    esac
done
echo ""
