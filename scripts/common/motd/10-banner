#!/bin/bash
# 10-banner — System identity and uptime

# Source brand.env for runtime brand discovery
BRAND_ENV="/etc/kura/brand.env"
if [ -f "${BRAND_ENV}" ]; then
    . "${BRAND_ENV}"
fi

# Brand color
_c="${BRAND_COLOR:-#9146FF}"
C=$(printf '\033[38;2;%d;%d;%dm' "0x${_c:1:2}" "0x${_c:3:2}" "0x${_c:5:2}")
W=$'\033[1;37m'   # bold white    — key values
w=$'\033[0;37m'   # dim white     — body text
R=$'\033[0m'      # reset

# OS name + version from brand.env (fallbacks must match brand-defaults.sh)
BP="${BRAND_PREFIX:-kura}"
OS_NAME="${BRAND_NAME:-Kura}"
if [ -f "/etc/${BP}/config.json" ]; then
    OS_VER=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "/etc/${BP}/config.json")
fi
OS_VER="${OS_VER:-${BRAND_VERSION:-unknown}}"

HOST=$(hostname 2>/dev/null || echo "unknown")
UP=$(uptime -p 2>/dev/null | sed 's/^up //' || echo "unknown")
KERN=$(uname -r)
ARCH=$(uname -m)
IP=$(hostname -I 2>/dev/null | awk '{print $1}')
IP="${IP:-N/A}"
LAST=$(lastlog -u root 2>/dev/null | tail -1 | awk '{print $2, $3, $4, $5, $6}')
LAST="${LAST:-never}"

echo ""
printf "  ${C}%s v%s${w}  |  ${W}%s${w}  |  up %s${R}\n" \
    "$OS_NAME" "$OS_VER" "$HOST" "$UP"
printf "  ${w}Kernel %s  |  %s  |  Last login: %s${R}\n" "$KERN $ARCH" "$IP" "$LAST"
echo ""
