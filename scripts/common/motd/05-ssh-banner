#!/bin/bash
# 05-ssh-banner — the Kura logo, 蔵 and the tagline (SSH sessions only, ADR-018)

# SSH_CONNECTION is not set when pam_motd runs; detect via process ancestry
_is_ssh() {
    local p=$PPID
    while [ "$p" -gt 1 ]; do
        [ "$(cat /proc/$p/comm 2>/dev/null)" = "sshd" ] && return 0
        p=$(awk '{print $4}' /proc/$p/stat 2>/dev/null) || return 1
    done
    return 1
}
_is_ssh || exit 0

# Brand colour and tagline from brand.env (fallbacks as in brand-defaults.sh)
BRAND_ENV="/etc/kura/brand.env"
[ -f "${BRAND_ENV}" ] && . "${BRAND_ENV}"
# rgb <hex>: a 24-bit foreground colour (SSH terminals draw it exactly)
rgb() { printf '\033[38;2;%d;%d;%dm' "0x${1:0:2}" "0x${1:2:2}" "0x${1:4:2}"; }
R=$'\033[0m'
MUTED=$(rgb 94a3b8)
TEXT=$(rgb e2e8f0)
LIGHT=$(rgb a970ff)

# The logo (as in scripts/common/issue.sh) in a vertical gradient: light
# purple at the top, the brand colour at the bottom, as 蔵 on the boot splash
LOGO=(
    "██   ██ ██    ██ ██████   █████"
    "██  ██  ██    ██ ██   ██ ██   ██"
    "█████   ██    ██ ██████  ███████"
    "██  ██  ██    ██ ██   ██ ██   ██"
    "██   ██  ██████  ██   ██ ██   ██"
)
brand="${BRAND_COLOR:-#9146FF}"
top=(0xb8 0x8c 0xff)
bottom=("0x${brand:1:2}" "0x${brand:3:2}" "0x${brand:5:2}")
last=$(( ${#LOGO[@]} - 1 ))
echo ""
for i in "${!LOGO[@]}"; do
    colour=$(printf '\033[38;2;%d;%d;%dm' \
        $(( top[0] + (bottom[0] - top[0]) * i / last )) \
        $(( top[1] + (bottom[1] - top[1]) * i / last )) \
        $(( top[2] + (bottom[2] - top[2]) * i / last )))
    printf '  %s%s%s\n' "${colour}" "${LOGO[i]}" "${R}"
done
echo ""
printf '  %s蔵 · THE STOREHOUSE%s\n' "${LIGHT}" "${R}"
printf '  %s%s%s\n' "${TEXT}" "${BRAND_TAGLINE:-The lightweight OS for your home server.}" "${R}"
printf '  %s%s%s\n' "${MUTED}" "────────────────────────────────────────" "${R}"
