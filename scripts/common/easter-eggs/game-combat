#!/bin/bash
# game-combat — Tactical Combat Simulator
# Used for: Fighter Combat, Guerrilla Engagement, Desert Warfare, Air-to-Ground

G=$'\033[1;32m'; g=$'\033[0;32m'; Y=$'\033[1;33m'
r=$'\033[1;31m'; W=$'\033[1;37m'; w=$'\033[0;37m'; R=$'\033[0m'

SCENARIO="$1"
[ -z "$SCENARIO" ] && SCENARIO="FIGHTER COMBAT"

case "$SCENARIO" in
    "FIGHTER COMBAT")
        PLAYER_UNITS="F-15 Eagles"; ENEMY_UNITS="MiG-29 Fulcrums"
        PLAYER_HP=100; ENEMY_HP=80; PLAYER_ATK=20; ENEMY_ATK=15
        ACTIONS=("ENGAGE" "MISSILE" "EVADE" "AFTERBURNER")
        ;;
    "GUERRILLA ENGAGEMENT")
        PLAYER_UNITS="Special Forces"; ENEMY_UNITS="Insurgent Cell"
        PLAYER_HP=80; ENEMY_HP=60; PLAYER_ATK=18; ENEMY_ATK=20
        ACTIONS=("ASSAULT" "AMBUSH" "FLANK" "RECON")
        ;;
    "DESERT WARFARE")
        PLAYER_UNITS="M1A2 Abrams"; ENEMY_UNITS="T-72 Battalion"
        PLAYER_HP=120; ENEMY_HP=100; PLAYER_ATK=25; ENEMY_ATK=18
        ACTIONS=("ADVANCE" "SHELL" "HULL DOWN" "SMOKE SCREEN")
        ;;
    "AIR-TO-GROUND ACTIONS")
        PLAYER_UNITS="A-10 Warthog"; ENEMY_UNITS="SAM Battery"
        PLAYER_HP=90; ENEMY_HP=70; PLAYER_ATK=30; ENEMY_ATK=22
        ACTIONS=("STRAFE" "BOMB RUN" "EVASIVE" "SUPPRESSION")
        ;;
esac

PHP=$PLAYER_HP; EHP=$ENEMY_HP
ROUND=1

show_status() {
    echo ""
    printf "  ${G}%-20s${w} HP: " "$PLAYER_UNITS"
    local pbar=$((PHP * 20 / PLAYER_HP))
    for ((i=0; i<20; i++)); do
        [ $i -lt $pbar ] && printf "${G}█${R}" || printf "${w}░${R}"
    done
    printf " ${W}%d/%d${R}\n" "$PHP" "$PLAYER_HP"

    printf "  ${r}%-20s${w} HP: " "$ENEMY_UNITS"
    local ebar=$((EHP * 20 / ENEMY_HP))
    for ((i=0; i<20; i++)); do
        [ $i -lt $ebar ] && printf "${r}█${R}" || printf "${w}░${R}"
    done
    printf " ${W}%d/%d${R}\n" "$EHP" "$ENEMY_HP"
    echo ""
}

echo ""
echo "${G}  ██ ${SCENARIO} ██${R}"
echo ""
echo "${g}  THEATER: ACTIVE COMBAT ZONE${R}"
echo "${g}  YOUR FORCE: ${W}${PLAYER_UNITS}${R}"
echo "${g}  ENEMY FORCE: ${r}${ENEMY_UNITS}${R}"
sleep 1

while [ $PHP -gt 0 ] && [ $EHP -gt 0 ]; do
    echo ""
    echo "${Y}  ── ROUND $ROUND ──${R}"
    show_status

    echo "${g}  TACTICAL OPTIONS:${R}"
    for i in "${!ACTIONS[@]}"; do
        printf "  ${w}%d) %s${R}\n" "$((i+1))" "${ACTIONS[$i]}"
    done
    echo ""
    printf "  ${W}ACTION? ${R}"
    read -r choice

    [[ "$choice" == "q" || "$choice" == "Q" ]] && { echo "  ${g}RETREAT${R}"; echo ""; exit 0; }
    [[ ! "$choice" =~ ^[1-4]$ ]] && { echo "  ${r}INVALID${R}"; continue; }

    idx=$((choice - 1))
    action="${ACTIONS[$idx]}"

    # Damage calculation with variance
    pdmg=$((PLAYER_ATK + RANDOM % 10 - 3))
    edmg=$((ENEMY_ATK + RANDOM % 10 - 3))

    # Action modifiers
    case "$idx" in
        0) pdmg=$((pdmg * 100 / 100)); edmg=$((edmg * 100 / 100)) ;;  # Balanced
        1) pdmg=$((pdmg * 150 / 100)); edmg=$((edmg * 120 / 100)) ;;  # High risk/reward
        2) pdmg=$((pdmg * 60 / 100));  edmg=$((edmg * 50 / 100))  ;;  # Defensive
        3) pdmg=$((pdmg * 130 / 100)); edmg=$((edmg * 80 / 100))  ;;  # Tactical advantage
    esac

    [ $pdmg -lt 0 ] && pdmg=0
    [ $edmg -lt 0 ] && edmg=0

    echo ""
    echo "  ${G}>> ${action}! Hit for ${pdmg} damage${R}"
    EHP=$((EHP - pdmg))
    [ $EHP -lt 0 ] && EHP=0

    if [ $EHP -gt 0 ]; then
        eidx=$((RANDOM % 4))
        echo "  ${r}<< ${ENEMY_UNITS} ${ACTIONS[$eidx]}! Hit for ${edmg} damage${R}"
        PHP=$((PHP - edmg))
        [ $PHP -lt 0 ] && PHP=0
    fi

    ((ROUND++))
    sleep 0.5
done

echo ""
show_status

if [ $PHP -gt 0 ]; then
    echo "  ${G}╔═══════════════════════════════════╗${R}"
    echo "  ${G}║     MISSION ACCOMPLISHED          ║${R}"
    echo "  ${G}║     ${ENEMY_UNITS} NEUTRALIZED${R}"
    echo "  ${G}╚═══════════════════════════════════╝${R}"
else
    echo "  ${r}╔═══════════════════════════════════╗${R}"
    echo "  ${r}║     MISSION FAILED                ║${R}"
    echo "  ${r}║     ${PLAYER_UNITS} LOST${R}"
    echo "  ${r}╚═══════════════════════════════════╝${R}"
fi
echo ""
echo "  ${g}Rounds: ${W}$((ROUND-1))${R}"
echo ""
