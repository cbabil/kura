#!/bin/bash
# game-chess — Simple Chess

G=$'\033[1;32m'; g=$'\033[0;32m'; Y=$'\033[1;33m'
r=$'\033[1;31m'; W=$'\033[1;37m'; w=$'\033[0;37m'; R=$'\033[0m'

declare -a BOARD

init_board() {
    BOARD=(
        "r" "n" "b" "q" "k" "b" "n" "r"
        "p" "p" "p" "p" "p" "p" "p" "p"
        "." "." "." "." "." "." "." "."
        "." "." "." "." "." "." "." "."
        "." "." "." "." "." "." "." "."
        "." "." "." "." "." "." "." "."
        "P" "P" "P" "P" "P" "P" "P" "P"
        "R" "N" "B" "Q" "K" "B" "N" "R"
    )
}

is_white() { [[ "$1" =~ [A-Z] ]]; }
is_black() { [[ "$1" =~ [a-z] ]]; }

draw_board() {
    echo ""
    printf "  ${w}  a  b  c  d  e  f  g  h${R}\n"
    for ((row=0; row<8; row++)); do
        printf "  ${w}%d${R}" "$((8-row))"
        for ((col=0; col<8; col++)); do
            local p="${BOARD[$((row*8+col))]}"
            local display="$p"
            case "$p" in
                K) display="♔";; Q) display="♕";; R) display="♖";; B) display="♗";; N) display="♘";; P) display="♙";;
                k) display="♚";; q) display="♛";; r) display="♜";; b) display="♝";; n) display="♞";; p) display="♟";;
                .) display=" ";;
            esac
            if (( (row+col) % 2 == 0 )); then
                is_black "$p" && printf " ${r}%s${R} " "$display" || printf " ${G}%s${R} " "$display"
            else
                is_black "$p" && printf " ${r}%s${R} " "$display" || printf " ${G}%s${R} " "$display"
            fi
        done
        printf "${w}%d${R}\n" "$((8-row))"
    done
    printf "  ${w}  a  b  c  d  e  f  g  h${R}\n"
    echo ""
}

parse_pos() {
    local col=$(($(printf '%d' "'${1:0:1}") - 97))
    local row=$((8 - ${1:1:1}))
    echo "$row $col"
}

try_move() {
    local fr=$1 fc=$2 tr=$3 tc=$4
    [[ $tr -lt 0 || $tr -gt 7 || $tc -lt 0 || $tc -gt 7 ]] && return 1
    local fi=$((fr*8+fc)) ti=$((tr*8+tc))
    local piece="${BOARD[$fi]}" target="${BOARD[$ti]}"
    ! is_white "$piece" && return 1
    is_white "$target" && return 1

    local dr=$((tr-fr)) dc=$((tc-fc))
    local adr=${dr#-} adc=${dc#-}

    case "$piece" in
        P)  # Pawn
            if [[ $dc -eq 0 && $dr -eq -1 && "$target" == "." ]]; then return 0; fi
            if [[ $dc -eq 0 && $dr -eq -2 && $fr -eq 6 && "$target" == "." && "${BOARD[$(((fr-1)*8+fc))]}" == "." ]]; then return 0; fi
            if [[ $adc -eq 1 && $dr -eq -1 ]] && is_black "$target"; then return 0; fi
            ;;
        R) # Rook
            if [[ $dr -eq 0 || $dc -eq 0 ]]; then return 0; fi ;;
        N) # Knight
            if [[ ($adr -eq 2 && $adc -eq 1) || ($adr -eq 1 && $adc -eq 2) ]]; then return 0; fi ;;
        B) # Bishop
            if [[ $adr -eq $adc && $adr -gt 0 ]]; then return 0; fi ;;
        Q) # Queen
            if [[ $dr -eq 0 || $dc -eq 0 || $adr -eq $adc ]]; then return 0; fi ;;
        K) # King
            if [[ $adr -le 1 && $adc -le 1 ]]; then return 0; fi ;;
    esac
    return 1
}

do_move() {
    local fr=$1 fc=$2 tr=$3 tc=$4
    BOARD[$((tr*8+tc))]="${BOARD[$((fr*8+fc))]}"
    BOARD[$((fr*8+fc))]="."
    # Pawn promotion
    [[ "${BOARD[$((tr*8+tc))]}" == "P" && $tr -eq 0 ]] && BOARD[$((tr*8+tc))]="Q"
    [[ "${BOARD[$((tr*8+tc))]}" == "p" && $tr -eq 7 ]] && BOARD[$((tr*8+tc))]="q"
}

cpu_move() {
    local moves=()
    for ((row=0; row<8; row++)); do
        for ((col=0; col<8; col++)); do
            local p="${BOARD[$((row*8+col))]}"
            ! is_black "$p" && continue
            for ((tr=0; tr<8; tr++)); do
                for ((tc=0; tc<8; tc++)); do
                    local target="${BOARD[$((tr*8+tc))]}"
                    is_black "$target" && continue
                    local dr=$((tr-row)) dc=$((tc-col))
                    local adr=${dr#-} adc=${dc#-}
                    local valid=false
                    case "$p" in
                        p) [[ $dc -eq 0 && $dr -eq 1 && "$target" == "." ]] && valid=true
                           [[ $dc -eq 0 && $dr -eq 2 && $row -eq 1 && "$target" == "." ]] && valid=true
                           [[ $adc -eq 1 && $dr -eq 1 ]] && is_white "$target" && valid=true ;;
                        r) [[ $dr -eq 0 || $dc -eq 0 ]] && valid=true ;;
                        n) [[ ($adr -eq 2 && $adc -eq 1) || ($adr -eq 1 && $adc -eq 2) ]] && valid=true ;;
                        b) [[ $adr -eq $adc && $adr -gt 0 ]] && valid=true ;;
                        q) [[ $dr -eq 0 || $dc -eq 0 || $adr -eq $adc ]] && valid=true ;;
                        k) [[ $adr -le 1 && $adc -le 1 && ($adr -gt 0 || $adc -gt 0) ]] && valid=true ;;
                    esac
                    $valid && moves+=("$row $col $tr $tc")
                done
            done
        done
    done

    [ ${#moves[@]} -eq 0 ] && return 1
    # Prefer captures
    local captures=()
    for m in "${moves[@]}"; do
        read -r _ _ tr tc <<< "$m"
        is_white "${BOARD[$((tr*8+tc))]}" && captures+=("$m")
    done
    if [ ${#captures[@]} -gt 0 ]; then
        read -r fr fc tr tc <<< "${captures[$((RANDOM % ${#captures[@]}))]}"
    else
        read -r fr fc tr tc <<< "${moves[$((RANDOM % ${#moves[@]}))]}"
    fi
    local fc_l=$(printf "\\$(printf '%03o' $((fc+97)))")
    local tc_l=$(printf "\\$(printf '%03o' $((tc+97)))")
    echo "  ${r}CPU: ${fc_l}$((8-fr)) -> ${tc_l}$((8-tr))${R}"
    do_move "$fr" "$fc" "$tr" "$tc"
}

echo ""
echo "${G}  ██ CHESS ██${R}"
echo "${w}  Move: from to (e.g. e2 e4). Q to quit.${R}"

init_board

while true; do
    draw_board
    printf "  ${g}Your move: ${R}"
    read -r from to
    [[ "$from" == "q" || "$from" == "Q" ]] && { echo ""; break; }
    [[ -z "$to" ]] && { echo "  ${r}Usage: e2 e4${R}"; continue; }

    read -r fr fc <<< "$(parse_pos "$from")"
    read -r tr tc <<< "$(parse_pos "$to")"
    if ! try_move "$fr" "$fc" "$tr" "$tc"; then
        echo "  ${r}Invalid move!${R}"; sleep 1; continue
    fi
    do_move "$fr" "$fc" "$tr" "$tc"

    cpu_move || { echo "  ${G}CHECKMATE — YOU WIN!${R}"; echo ""; break; }
    sleep 0.5
done
