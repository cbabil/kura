#!/bin/bash
# games — Interactive WOPR game menu (WarGames, 1983)

G=$'\033[1;32m'; g=$'\033[0;32m'; W=$'\033[1;37m'
w=$'\033[0;37m'; Y=$'\033[1;33m'; R=$'\033[0m'

GAMES=(
    "FALKEN'S MAZE"
    "BLACK JACK"
    "GIN RUMMY"
    "HEARTS"
    "BRIDGE"
    "CHECKERS"
    "CHESS"
    "POKER"
    "FIGHTER COMBAT"
    "GUERRILLA ENGAGEMENT"
    "DESERT WARFARE"
    "AIR-TO-GROUND ACTIONS"
    "THEATERWIDE TACTICAL WARFARE"
    "THEATERWIDE BIOTOXIC AND CHEMICAL WARFARE"
    "GLOBAL THERMONUCLEAR WAR"
)

show_menu() {
    echo ""
    echo "${G}  GREETINGS PROFESSOR FALKEN${R}"
    echo ""
    echo "${g}  LIST OF GAMES${R}"
    echo ""
    for i in "${!GAMES[@]}"; do
        printf "${g}  %2d) %s${R}\n" "$((i + 1))" "${GAMES[$i]}"
    done
    echo ""
    printf "${g}   0) EXIT${R}\n"
    echo ""
}

play_game() {
    local game="$1"
    case "$game" in
        "FALKEN'S MAZE")           game-maze ;;
        "BLACK JACK")              game-blackjack ;;
        "GIN RUMMY")               game-cards "GIN RUMMY" ;;
        "HEARTS")                  game-cards "HEARTS" ;;
        "BRIDGE")                  game-cards "BRIDGE" ;;
        "CHECKERS")                game-checkers ;;
        "CHESS")                   game-chess ;;
        "POKER")                   game-poker ;;
        "FIGHTER COMBAT")          game-combat "FIGHTER COMBAT" ;;
        "GUERRILLA ENGAGEMENT")    game-combat "GUERRILLA ENGAGEMENT" ;;
        "DESERT WARFARE")          game-combat "DESERT WARFARE" ;;
        "AIR-TO-GROUND ACTIONS")   game-combat "AIR-TO-GROUND ACTIONS" ;;
        "THEATERWIDE TACTICAL WARFARE")
            game-warfare "THEATERWIDE TACTICAL WARFARE" ;;
        "THEATERWIDE BIOTOXIC AND CHEMICAL WARFARE")
            game-warfare "THEATERWIDE BIOTOXIC AND CHEMICAL WARFARE" ;;
        "GLOBAL THERMONUCLEAR WAR") war ;;
    esac
}

while true; do
    show_menu
    printf "${W}  WHICH GAME? ${R}"
    read -r choice

    case "$choice" in
        0|q|Q|exit|EXIT)
            echo ""; echo "${g}  GOODBYE PROFESSOR FALKEN${R}"; echo ""; break ;;
    esac

    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#GAMES[@]}" ]; then
        play_game "${GAMES[$((choice - 1))]}"
    else
        echo ""; echo "${Y}  INVALID SELECTION. PLEASE CHOOSE A GAME.${R}"; sleep 1
    fi
done
