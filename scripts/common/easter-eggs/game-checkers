#!/bin/bash
# game-checkers — Checkers (8x8 board)

G=$'\033[1;32m'; g=$'\033[0;32m'; Y=$'\033[1;33m'
r=$'\033[1;31m'; W=$'\033[1;37m'; w=$'\033[0;37m'; R=$'\033[0m'
BG=$'\033[42m'; BD=$'\033[40m'

# Board: 0=empty, 1=player(green), 2=cpu(red), 3=player king, 4=cpu king
declare -a BOARD
init_board() {
    for ((i=0; i<64; i++)); do BOARD[$i]=0; done
    # CPU pieces (top 3 rows, dark squares only)
    for row in 0 1 2; do
        for col in 0 1 2 3 4 5 6 7; do
            if (( (row + col) % 2 == 1 )); then BOARD[$((row*8+col))]=2; fi
        done
    done
    # Player pieces (bottom 3 rows)
    for row in 5 6 7; do
        for col in 0 1 2 3 4 5 6 7; do
            if (( (row + col) % 2 == 1 )); then BOARD[$((row*8+col))]=1; fi
        done
    done
}

draw_board() {
    echo ""
    echo "${G}  CHECKERS${R}  ${g}You: ${G}●${g}  CPU: ${r}●${R}"
    echo ""
    printf "  ${w}  a b c d e f g h${R}\n"
    for ((row=0; row<8; row++)); do
        printf "  ${w}%d${R} " "$((8-row))"
        for ((col=0; col<8; col++)); do
            local p=${BOARD[$((row*8+col))]}
            if (( (row+col) % 2 == 0 )); then
                printf "${w}.${R} "
            else
                case $p in
                    0) printf "${w}-${R} " ;;
                    1) printf "${G}●${R} " ;;
                    2) printf "${r}●${R} " ;;
                    3) printf "${G}★${R} " ;;
                    4) printf "${r}★${R} " ;;
                esac
            fi
        done
        printf "${w}%d${R}\n" "$((8-row))"
    done
    printf "  ${w}  a b c d e f g h${R}\n"
    echo ""
}

parse_pos() {
    local pos="$1"
    local col=$(($(printf '%d' "'${pos:0:1}") - 97))
    local row=$((8 - ${pos:1:1}))
    echo "$row $col"
}

is_player() { [[ ${BOARD[$1]} -eq 1 || ${BOARD[$1]} -eq 3 ]]; }
is_cpu() { [[ ${BOARD[$1]} -eq 2 || ${BOARD[$1]} -eq 4 ]]; }

try_move() {
    local fr=$1 fc=$2 tr=$3 tc=$4
    [[ $tr -lt 0 || $tr -gt 7 || $tc -lt 0 || $tc -gt 7 ]] && return 1
    local fi=$((fr*8+fc)) ti=$((tr*8+tc))
    ! is_player $fi && return 1
    local dr=$((tr-fr)) dc=$((tc-fc))

    # Simple move
    if [[ ${dr#-} -eq 1 && ${dc#-} -eq 1 && ${BOARD[$ti]} -eq 0 ]]; then
        # Regular pieces can only move forward (toward row 0)
        if [[ ${BOARD[$fi]} -eq 1 && $dr -gt 0 ]]; then return 1; fi
        BOARD[$ti]=${BOARD[$fi]}; BOARD[$fi]=0
        [[ $tr -eq 0 ]] && BOARD[$ti]=3  # King me
        return 0
    fi

    # Jump
    if [[ ${dr#-} -eq 2 && ${dc#-} -eq 2 ]]; then
        local mr=$(( (fr+tr)/2 )) mc=$(( (fc+tc)/2 )) mi=$((mr*8+mc))
        if is_cpu $mi && [[ ${BOARD[$ti]} -eq 0 ]]; then
            if [[ ${BOARD[$fi]} -eq 1 && $dr -gt 0 ]]; then return 1; fi
            BOARD[$ti]=${BOARD[$fi]}; BOARD[$fi]=0; BOARD[$mi]=0
            [[ $tr -eq 0 ]] && BOARD[$ti]=3
            return 0
        fi
    fi
    return 1
}

cpu_move() {
    # Try jumps first, then simple moves
    local moves=()
    for ((row=0; row<8; row++)); do
        for ((col=0; col<8; col++)); do
            local i=$((row*8+col))
            ! is_cpu $i && continue
            local piece=${BOARD[$i]}
            for dr in -1 1; do
                [[ $piece -eq 2 && $dr -lt 0 ]] && continue  # Regular only forward
                for dc in -1 1; do
                    # Jump
                    local jr=$((row+dr*2)) jc=$((col+dc*2)) mr=$((row+dr)) mc=$((col+dc))
                    if [[ $jr -ge 0 && $jr -le 7 && $jc -ge 0 && $jc -le 7 ]]; then
                        local ji=$((jr*8+jc)) mi2=$((mr*8+mc))
                        if is_player $mi2 && [[ ${BOARD[$ji]} -eq 0 ]]; then
                            moves=("J $row $col $jr $jc $mi2" "${moves[@]}"); continue
                        fi
                    fi
                    # Simple
                    local nr=$((row+dr)) nc=$((col+dc))
                    if [[ $nr -ge 0 && $nr -le 7 && $nc -ge 0 && $nc -le 7 ]]; then
                        [[ ${BOARD[$((nr*8+nc))]} -eq 0 ]] && moves+=("M $row $col $nr $nc")
                    fi
                done
            done
        done
    done

    [ ${#moves[@]} -eq 0 ] && return 1
    local pick="${moves[$((RANDOM % ${#moves[@]}))]}"
    read -r type fr fc tr tc extra <<< "$pick"
    BOARD[$((tr*8+tc))]=${BOARD[$((fr*8+fc))]}; BOARD[$((fr*8+fc))]=0
    [[ "$type" == "J" ]] && BOARD[$extra]=0
    [[ $tr -eq 7 ]] && BOARD[$((tr*8+tc))]=4  # King
    local fc_l=$(printf "\\$(printf '%03o' $((fc+97)))")
    local tc_l=$(printf "\\$(printf '%03o' $((tc+97)))")
    echo "  ${r}CPU: ${fc_l}$((8-fr)) -> ${tc_l}$((8-tr))${R}"
}

count_pieces() {
    local p=0 c=0
    for ((i=0; i<64; i++)); do
        is_player $i && ((p++))
        is_cpu $i && ((c++))
    done
    echo "$p $c"
}

echo ""
echo "${G}  ██ CHECKERS ██${R}"
echo "${w}  Move: from to (e.g. c3 d4). Q to quit.${R}"

init_board

while true; do
    draw_board
    read -r pc cc <<< "$(count_pieces)"
    [ "$pc" -eq 0 ] && { echo "  ${r}CPU WINS${R}"; echo ""; break; }
    [ "$cc" -eq 0 ] && { echo "  ${G}YOU WIN!${R}"; echo ""; break; }

    printf "  ${g}Your move: ${R}"
    read -r from to
    [[ "$from" == "q" || "$from" == "Q" ]] && { echo ""; break; }
    [[ -z "$to" ]] && { echo "  ${r}Usage: c3 d4${R}"; continue; }

    read -r fr fc <<< "$(parse_pos "$from")"
    read -r tr tc <<< "$(parse_pos "$to")"
    if ! try_move "$fr" "$fc" "$tr" "$tc"; then
        echo "  ${r}Invalid move!${R}"; sleep 1; continue
    fi

    cpu_move || { echo "  ${G}CPU CANNOT MOVE — YOU WIN!${R}"; echo ""; break; }
    sleep 0.5
done
