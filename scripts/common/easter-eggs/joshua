#!/bin/bash
# joshua — The WOPR AI responds

G=$'\033[1;32m'
g=$'\033[0;32m'
R=$'\033[0m'

echo ""
echo "${G}  JOSHUA (WOPR)${R}"
echo ""

# Typing effect
type_slow() {
    local text="$1"
    for ((i=0; i<${#text}; i++)); do
        printf "${g}%s${R}" "${text:$i:1}"
        sleep 0.03
    done
    echo ""
}

type_slow "  A STRANGE GAME."
sleep 0.5
type_slow "  THE ONLY WINNING MOVE IS NOT TO PLAY."
sleep 0.5
echo ""
type_slow "  HOW ABOUT A NICE GAME OF CHESS?"
echo ""
