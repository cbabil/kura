#!/bin/bash
# game-warfare — Theaterwide Warfare Simulator

G=$'\033[1;32m'; g=$'\033[0;32m'; Y=$'\033[1;33m'
r=$'\033[1;31m'; W=$'\033[1;37m'; w=$'\033[0;37m'; R=$'\033[0m'

SCENARIO="$1"
[ -z "$SCENARIO" ] && SCENARIO="THEATERWIDE TACTICAL WARFARE"

BIOWAR=false
[[ "$SCENARIO" == *"BIOTOXIC"* ]] && BIOWAR=true

echo ""
echo "${G}  ██ ${SCENARIO} ██${R}"
echo ""

# Resources
TROOPS=1000; TANKS=50; AIR=30; SUPPLY=100
E_TROOPS=1200; E_TANKS=60; E_AIR=25
MORALE=80; E_MORALE=80
TERRITORY=40  # percent controlled
ROUND=1

$BIOWAR && { CHEM=5; echo "  ${r}WARNING: CHEMICAL/BIOLOGICAL ASSETS AVAILABLE${R}"; echo ""; }

show_status() {
    printf "  ${G}═══ ALLIED FORCES ═══${R}              ${r}═══ ENEMY FORCES ═══${R}\n"
    printf "  ${w}Troops:    ${W}%-6d${R}                 ${w}Troops:    ${W}%d${R}\n" "$TROOPS" "$E_TROOPS"
    printf "  ${w}Armor:     ${W}%-6d${R}                 ${w}Armor:     ${W}%d${R}\n" "$TANKS" "$E_TANKS"
    printf "  ${w}Air Power: ${W}%-6d${R}                 ${w}Air Power: ${W}%d${R}\n" "$AIR" "$E_AIR"
    printf "  ${w}Supply:    ${W}%-6d${R}                 ${w}Morale:    ${W}%d%%${R}\n" "$SUPPLY" "$E_MORALE"
    printf "  ${w}Morale:    ${W}%d%%${R}\n" "$MORALE"
    $BIOWAR && printf "  ${r}Chem/Bio:  ${W}%d${R}\n" "$CHEM"
    echo ""
    printf "  ${Y}Territory Controlled: "
    for ((i=0; i<50; i++)); do
        if [ $i -lt $((TERRITORY/2)) ]; then printf "${G}█"; else printf "${r}█"; fi
    done
    printf "${Y} %d%%${R}\n" "$TERRITORY"
    echo ""
}

while [ $TROOPS -gt 0 ] && [ $E_TROOPS -gt 0 ] && [ $TERRITORY -gt 0 ] && [ $TERRITORY -lt 100 ]; do
    echo "${Y}  ══════ TURN $ROUND ══════${R}"
    echo ""
    show_status

    echo "${g}  STRATEGIC OPTIONS:${R}"
    echo "${w}  1) GROUND OFFENSIVE    — Commit troops and armor${R}"
    echo "${w}  2) AIR STRIKE          — Precision bombing${R}"
    echo "${w}  3) DEFENSIVE POSITION  — Fortify and resupply${R}"
    echo "${w}  4) COMBINED ARMS       — Coordinated assault${R}"
    $BIOWAR && echo "${r}  5) CHEMICAL STRIKE     — Deploy chemical weapons${R}"
    echo "${w}  0) CEASEFIRE${R}"
    echo ""
    printf "  ${W}ORDERS? ${R}"
    read -r cmd

    [[ "$cmd" == "0" || "$cmd" == "q" ]] && { echo "  ${Y}CEASEFIRE DECLARED${R}"; echo ""; break; }

    ploss=0; eloss=0; tloss=0; etloss=0; terr_change=0

    case "$cmd" in
        1) # Ground offensive
            ploss=$((50 + RANDOM % 80)); eloss=$((60 + RANDOM % 100))
            tloss=$((RANDOM % 8)); etloss=$((RANDOM % 10))
            terr_change=$((3 + RANDOM % 5))
            SUPPLY=$((SUPPLY - 15))
            echo "  ${G}>> GROUND OFFENSIVE LAUNCHED${R}"
            ;;
        2) # Air strike
            ploss=$((10 + RANDOM % 20)); eloss=$((40 + RANDOM % 80))
            aloss=$((2 + RANDOM % 4)); AIR=$((AIR - aloss))
            etloss=$((3 + RANDOM % 8))
            terr_change=$((1 + RANDOM % 3))
            SUPPLY=$((SUPPLY - 10))
            echo "  ${G}>> AIR STRIKE DEPLOYED ($aloss aircraft lost)${R}"
            ;;
        3) # Defensive
            ploss=$((10 + RANDOM % 20)); eloss=$((20 + RANDOM % 40))
            SUPPLY=$((SUPPLY + 20)); MORALE=$((MORALE + 5))
            terr_change=$((-1 - RANDOM % 2))
            echo "  ${G}>> DEFENSIVE POSITIONS FORTIFIED${R}"
            ;;
        4) # Combined arms
            ploss=$((40 + RANDOM % 60)); eloss=$((80 + RANDOM % 120))
            tloss=$((3 + RANDOM % 5)); etloss=$((5 + RANDOM % 10))
            aloss=$((1 + RANDOM % 3)); AIR=$((AIR - aloss))
            terr_change=$((5 + RANDOM % 8))
            SUPPLY=$((SUPPLY - 25))
            echo "  ${G}>> COMBINED ARMS ASSAULT${R}"
            ;;
        5) # Chemical (if available)
            if $BIOWAR && [ "$CHEM" -gt 0 ]; then
                ploss=$((5 + RANDOM % 10)); eloss=$((150 + RANDOM % 200))
                terr_change=$((8 + RANDOM % 10))
                E_MORALE=$((E_MORALE - 20))
                MORALE=$((MORALE - 10))  # War crime penalty
                ((CHEM--))
                echo "  ${r}>> CHEMICAL WEAPONS DEPLOYED${R}"
                echo "  ${r}   INTERNATIONAL CONDEMNATION${R}"
            else
                echo "  ${r}UNAVAILABLE${R}"; continue
            fi
            ;;
        *) echo "  ${r}INVALID ORDER${R}"; continue ;;
    esac

    # Enemy counter-attack
    ecmd=$((RANDOM % 3))
    eploss=$((20 + RANDOM % 50))
    ploss=$((ploss + eploss))
    echo "  ${r}<< ENEMY COUNTER-ATTACK (-$eploss troops)${R}"

    # Apply losses
    TROOPS=$((TROOPS - ploss)); E_TROOPS=$((E_TROOPS - eloss))
    TANKS=$((TANKS - tloss)); E_TANKS=$((E_TANKS - etloss))
    TERRITORY=$((TERRITORY + terr_change))

    [ $TROOPS -lt 0 ] && TROOPS=0; [ $E_TROOPS -lt 0 ] && E_TROOPS=0
    [ $TANKS -lt 0 ] && TANKS=0; [ $E_TANKS -lt 0 ] && E_TANKS=0
    [ $AIR -lt 0 ] && AIR=0; [ $E_AIR -lt 0 ] && E_AIR=0
    [ $SUPPLY -lt 0 ] && SUPPLY=0
    [ $TERRITORY -lt 0 ] && TERRITORY=0; [ $TERRITORY -gt 100 ] && TERRITORY=100

    # Morale effects
    [ $SUPPLY -lt 20 ] && MORALE=$((MORALE - 10))
    [ $E_TROOPS -lt 400 ] && E_MORALE=$((E_MORALE - 5))
    [ $MORALE -lt 20 ] && { echo "  ${r}TROOPS REFUSING ORDERS${R}"; TROOPS=$((TROOPS / 2)); }
    [ $E_MORALE -lt 20 ] && { echo "  ${G}ENEMY FORCES SURRENDERING${R}"; E_TROOPS=$((E_TROOPS / 2)); }

    printf "  ${w}Losses — You: ${r}%d troops, %d tanks${w}  Enemy: ${G}%d troops, %d tanks${R}\n" \
        "$ploss" "$tloss" "$eloss" "$etloss"
    echo ""
    ((ROUND++))
    sleep 0.5
done

echo ""
show_status

if [ $TERRITORY -ge 100 ]; then
    echo "${G}  ╔═══════════════════════════════════════╗${R}"
    echo "${G}  ║      TOTAL VICTORY                    ║${R}"
    echo "${G}  ║      ALL TERRITORY SECURED             ║${R}"
    echo "${G}  ╚═══════════════════════════════════════╝${R}"
elif [ $E_TROOPS -le 0 ]; then
    echo "${G}  ╔═══════════════════════════════════════╗${R}"
    echo "${G}  ║      ENEMY FORCES DESTROYED           ║${R}"
    echo "${G}  ╚═══════════════════════════════════════╝${R}"
elif [ $TROOPS -le 0 ] || [ $TERRITORY -le 0 ]; then
    echo "${r}  ╔═══════════════════════════════════════╗${R}"
    echo "${r}  ║      DEFEAT                           ║${R}"
    echo "${r}  ╚═══════════════════════════════════════╝${R}"
else
    echo "${Y}  CEASEFIRE — Territory held: ${TERRITORY}%${R}"
fi

echo ""
echo "  ${g}A STRANGE GAME.${R}"
echo "  ${g}THE ONLY WINNING MOVE IS NOT TO PLAY.${R}"
echo ""
