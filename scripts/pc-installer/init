#!/bin/bash
# scripts/pc-installer/init — PID 1 of the PC installer's initrd (ADR-017).
# Sets up a minimal system in RAM, finds the USB key it booted from, runs
# install_kura (install.sh) until it succeeds or the user turns the PC off,
# then powers off so the next start boots Kura from the internal drive.
# The screen gets Terminus 16x32 (120x33 cells at 1920x1080) and ui.sh's
# colours.
# build-initrd.sh replaces __BRAND__ and __LABEL__.

export PATH=/usr/sbin:/usr/bin
export INSTALLER_BRAND="__BRAND__"
export INSTALLER_COMMON="/usr/lib/__BRAND__-installer"
export INSTALLER_LABEL="__LABEL__"
COUNTDOWN=10

# busybox finds itself through /proc/self/exe: mount /proc first, and call
# it by its full path until its applets are installed
/usr/bin/busybox mount -t proc proc /proc
/usr/bin/busybox --install -s /usr/bin
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
# What udev would add: bash's process substitution opens /dev/fd/N
ln -s /proc/self/fd /dev/fd
ln -s fd/0 /dev/stdin
ln -s fd/1 /dev/stdout
ln -s fd/2 /dev/stderr

# The screen, plus the serial port when there is one (VMs, the boot test)
exec < /dev/console > /dev/console 2>&1
if [ -c /dev/ttyS0 ] && : 2>/dev/null > /dev/ttyS0; then
    exec > >(tee /dev/ttyS0) 2>&1
fi

setfont -C /dev/tty1 "${INSTALLER_COMMON}/font.psf" 2>/dev/null || true
# shellcheck disable=SC1091
source "${INSTALLER_COMMON}/ui.sh"
ui_palette
ui_clear
ui_header
ui_steps 1
echo
ui_note "Looking for the installer's USB key ..."

while read -r module; do
    case "${module}" in ''|'#'*) continue ;; esac
    modprobe -q "${module}" 2>/dev/null || true
done < "${INSTALLER_COMMON}/modules.list"

# The key's FAT partition; USB devices can take a few seconds to appear
key_part=""
for _ in $(seq 30); do
    key_part=$(findfs "LABEL=${INSTALLER_LABEL}" 2>/dev/null) && break
    sleep 1
done
if [ -z "${key_part}" ]; then
    ui_error "The installer's USB key was not found. Turn the PC off and try another USB port."
    while :; do sleep 3600; done
fi
key_disk=$(basename "$(readlink -f "/sys/class/block/${key_part##*/}/..")")
export KEY_DIR=/run/key
mkdir -p "${KEY_DIR}"
if ! mount -t vfat "${key_part}" "${KEY_DIR}"; then
    ui_error "The installer's USB key could not be read. Turn the PC off and write the key again."
    while :; do sleep 3600; done
fi

# Disks probe in the background: wait until the list stops changing
previous=""
for _ in $(seq 15); do
    current=$(ls /sys/block)
    [ "${current}" = "${previous}" ] && break
    previous="${current}"
    sleep 2
done

# shellcheck disable=SC1091
source "${INSTALLER_COMMON}/install.sh"
until install_kura "${key_disk}" "${COUNTDOWN}"; do
    echo
    ui_note "Press Enter to try again, or turn the PC off."
    read -r _
done

umount "${KEY_DIR}"
sync
echo
ui_note "The PC turns off in 15 seconds."
sleep 15
poweroff -f
