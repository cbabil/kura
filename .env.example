# OS Build Configuration (Debian)
# Copy to .env and edit: cp .env.example .env

# ---- Config Version ----
OS_CONF_VERSION="4"

# ---- Debian Base ----
OS_DEBIAN_SUITE="trixie"
OS_DEBIAN_MIRROR="http://deb.debian.org/debian"
OS_CROSS_BUILD="auto"    # auto|yes|no

# ---- Tomo platform ----
# Released Tomo .deb installed into the image (defaults pinned in
# scripts/common/fetch-tomo.sh). Changing the version requires both checksums
# from the release's checksums.sha256.
#OS_TOMO_VERSION="0.0.76"
#OS_TOMO_SHA256_ARM64=""
#OS_TOMO_SHA256_AMD64=""
#OS_TOMO_DEB="/path/to/tomo_x.y.z_arch.deb"   # local build, skips download + checksum

# ---- Bun Runtime ----
OS_BUN_VERSION="1.2.4"
OS_BUN_SHA256_X64="e03eb2559a61af0cfb7acf3e59272d55613ef14078f156f7b22512456caa0f8b"
OS_BUN_SHA256_AARCH64="694a1b39ad3560f3fc7c8e0ac42df277d7ac4f28fe373646104000ddff9ae85c"

# ---- Parallelism ----
#OS_PARALLEL_JOBS=""

# ---- Branding ----
OS_BRAND="kura"
OS_NAME="Kura"
OS_COLOR="#9146FF"
OS_VERSION="0.0.1"
OS_API_ENDPOINT="https://api.kura.io"
OS_WS_ENDPOINT="wss://api.kura.io/ws"
OS_REGISTRY="registry.kura.io"

# ---- Supervisor WebSocket ----
OS_WS_HEARTBEAT_INTERVAL="30000"   # ms between heartbeat pings
OS_WS_HEARTBEAT_TIMEOUT="90000"    # ms before connection is considered dead
OS_WS_RECONNECT_BASE="1000"        # ms initial reconnect delay (exponential backoff)
OS_WS_RECONNECT_MAX="60000"        # ms maximum reconnect delay cap

# ---- Distribution ----
OS_HOSTNAME="kura"
OS_USER="admin"
OS_USER_PASSWD="admin"
# Root's console password. Empty: root is locked; use the login user and sudo.
OS_ROOT_PASSWD=""
# The login user must set a new password at first login. Set to "false" only
# when OS_USER_PASSWD is a private password you want to keep.
OS_USER_PASSWD_EXPIRE="true"
OS_ISSUE="Welcome to Kura"

# ---- Network ----
OS_DHCP_INTERFACE="eth0"

# ---- Logging ----
OS_JOURNAL_MAX_SIZE="100M"
OS_JOURNAL_MAX_FILE_SEC="1week"

# ---- Filesystem ----
OS_ROOTFS_SIZE="2G"

# ---- Build Directories ----
OS_TMP="/home/kura/tmp"
