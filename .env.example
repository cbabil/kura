# OS Build Configuration (Debian)
# Copy to .env and edit: cp .env.example .env

# ---- Config Version ----
OS_CONF_VERSION="4"

# ---- Debian Base ----
OS_DEBIAN_SUITE="trixie"
OS_DEBIAN_MIRROR="http://deb.debian.org/debian"
OS_CROSS_BUILD="auto"    # auto|yes|no

# ---- Bun Runtime ----
OS_BUN_VERSION="1.2.4"
OS_BUN_SHA256_X64="e03eb2559a61af0cfb7acf3e59272d55613ef14078f156f7b22512456caa0f8b"
OS_BUN_SHA256_AARCH64="694a1b39ad3560f3fc7c8e0ac42df277d7ac4f28fe373646104000ddff9ae85c"

# ---- Parallelism ----
#OS_PARALLEL_JOBS=""

# ---- Branding ----
OS_BRAND="falken"
OS_NAME="FalkenOS"
OS_COLOR="#33ff00"
OS_VERSION="0.0.1"
OS_API_ENDPOINT="https://api.falken.io"
OS_REGISTRY="registry.falken.io"

# ---- Distribution ----
OS_HOSTNAME="falkenos"
OS_USER="joshua"
OS_USER_PASSWD="joshua"
OS_ROOT_PASSWD="falken"
OS_ISSUE="Greetings, Professor Falken. Shall we play a game?"

# ---- Network ----
OS_DHCP_INTERFACE="eth0"

# ---- Logging ----
OS_JOURNAL_MAX_SIZE="100M"
OS_JOURNAL_MAX_FILE_SEC="1week"

# ---- Filesystem ----
OS_ROOTFS_SIZE="2G"

# ---- Build Directories ----
OS_TMP="/home/falkenos/tmp"
