# StraturaOS Build Configuration (Debian)
# Copy to .env and edit: cp .env.example .env

# ---- Config Version ----
STRATURAOS_CONF_VERSION="2"

# ---- Debian Base ----
STRATURAOS_DEBIAN_SUITE="trixie"
STRATURAOS_DEBIAN_MIRROR="http://deb.debian.org/debian"
STRATURAOS_CROSS_BUILD="auto"    # auto|yes|no

# ---- Parallelism ----
#STRATURAOS_PARALLEL_JOBS=""

# ---- Distribution ----
STRATURAOS_NAME="StraturaOS"
STRATURAOS_VERSION="2.0"
STRATURAOS_HOSTNAME="straturaos"
STRATURAOS_ROOT_PASSWD="stratura"
STRATURAOS_ISSUE="Welcome to StraturaOS"

# ---- Network ----
STRATURAOS_DHCP_INTERFACE="eth0"

# ---- Filesystem ----
STRATURAOS_ROOTFS_SIZE="2G"

# ---- Build Directories ----
STRATURAOS_TMP="/home/straturaos/tmp"
