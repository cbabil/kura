# OS Build Configuration (Debian)
# Copy to .env and edit: cp .env.example .env

# ---- Config Version ----
OS_CONF_VERSION="4"

# ---- Debian Base ----
OS_DEBIAN_SUITE="trixie"
OS_DEBIAN_MIRROR="http://deb.debian.org/debian"
OS_CROSS_BUILD="auto"    # auto|yes|no

# ---- Parallelism ----
#OS_PARALLEL_JOBS=""

# ---- Branding ----
OS_BRAND="kura"
OS_NAME="Kura"
OS_COLOR="#9146FF"
OS_VERSION="0.0.1"

# ---- Distribution ----
OS_HOSTNAME="kura"
OS_USER="admin"
OS_USER_PASSWD="admin"
# Root's console password. Empty: root is locked; use the login user and sudo.
OS_ROOT_PASSWD=""
# The login user must set a new password at first login. Set to "false" only
# when OS_USER_PASSWD is a private password you want to keep.
OS_USER_PASSWD_EXPIRE="true"
OS_ISSUE="Welcome to Kura"

# ---- Network ----
OS_DHCP_INTERFACE="eth0"

# ---- Logging ----
OS_JOURNAL_MAX_SIZE="100M"
OS_JOURNAL_MAX_FILE_SEC="1week"

# ---- Filesystem ----
OS_ROOTFS_SIZE="2G"       # Pi image root partition
OS_PC_ROOTFS_SIZE="3G"    # PC image root (firmware and all kernel modules)

# ---- Build Directories ----
OS_TMP="/home/kura/tmp"
