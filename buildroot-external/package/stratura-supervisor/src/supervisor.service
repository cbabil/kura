[Unit]
Description=StraturaOS Supervisor
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=simple
Restart=always
RestartSec=10
WorkingDirectory=/var/lib/stratura-supervisor

# Pre-flight check - ensure Docker is ready
ExecStartPre=/usr/bin/stratura-healthcheck

# Main supervisor process
ExecStart=/usr/bin/stratura-supervisor

# Environment
Environment=PYTHONPATH=/usr/lib/stratura
Environment=DOCKER_HOST=unix:///var/run/docker.sock

# Security hardening
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/stratura-supervisor /var/lib/stratura /var/run/docker.sock

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stratura-supervisor

[Install]
WantedBy=multi-user.target
