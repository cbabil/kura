[Unit]
Description=straturaOS Supervisor
After=docker.service dbus.socket
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=10
WorkingDirectory=/var/lib/stratura-supervisor
ExecStartPre=/usr/bin/stratura-supervisor-healthcheck
ExecStart=/usr/bin/stratura-supervisor
Environment=DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
Environment=DOCKER_HOST=unix:///var/run/docker.sock

# Security hardening
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadOnlyPaths=/etc
ReadWritePaths=/var/lib/stratura-supervisor /var/lib/docker

[Install]
WantedBy=multi-user.target 