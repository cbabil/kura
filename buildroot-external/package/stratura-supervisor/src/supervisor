#!/usr/bin/env python3

import json
import os
import sys
import time
import subprocess
import requests
import logging
from pathlib import Path

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger('stratura-supervisor')


class DockerCLI:
    """Docker operations via CLI subprocess calls"""

    @staticmethod
    def run_cmd(cmd: list, check: bool = True) -> subprocess.CompletedProcess:
        """Run docker command and return result"""
        full_cmd = ['docker'] + cmd
        try:
            result = subprocess.run(
                full_cmd,
                capture_output=True,
                text=True,
                check=check
            )
            return result
        except subprocess.CalledProcessError as e:
            logger.error(f"Docker command failed: {' '.join(full_cmd)}")
            logger.error(f"stderr: {e.stderr}")
            raise

    @staticmethod
    def container_exists(name: str) -> bool:
        """Check if container exists"""
        result = DockerCLI.run_cmd(
            ['ps', '-a', '--filter', f'name=^{name}$', '--format', '{{.Names}}'],
            check=False
        )
        return name in result.stdout.strip().split('\n')

    @staticmethod
    def container_running(name: str) -> bool:
        """Check if container is running"""
        result = DockerCLI.run_cmd(
            ['ps', '--filter', f'name=^{name}$', '--format', '{{.Names}}'],
            check=False
        )
        return name in result.stdout.strip().split('\n')

    @staticmethod
    def start_container(name: str):
        """Start existing container"""
        DockerCLI.run_cmd(['start', name])

    @staticmethod
    def create_and_run(image: str, name: str, **kwargs):
        """Create and run a new container"""
        cmd = ['run', '-d', '--name', name, '--restart', 'always']

        # Add environment variables
        for key, value in kwargs.get('environment', {}).items():
            cmd.extend(['-e', f'{key}={value}'])

        # Add port mappings
        for port in kwargs.get('ports', []):
            cmd.extend(['-p', port])

        # Add volume mounts
        for volume in kwargs.get('volumes', []):
            cmd.extend(['-v', volume])

        # Add labels
        for key, value in kwargs.get('labels', {}).items():
            cmd.extend(['--label', f'{key}={value}'])

        cmd.append(image)
        DockerCLI.run_cmd(cmd)

    @staticmethod
    def pull_image(image: str):
        """Pull docker image"""
        DockerCLI.run_cmd(['pull', image])


class StraturaSupervisor:
    def __init__(self):
        self.config_path = '/etc/stratura/supervisor-config.json'
        self.state_path = '/var/lib/stratura-supervisor/state.json'
        self.docker = DockerCLI()
        self.config = {}
        self.load_config()

    def load_config(self):
        try:
            with open(self.config_path, 'r') as f:
                self.config = json.load(f)
        except FileNotFoundError:
            logger.warning(f"Config not found at {self.config_path}, using defaults")
            self.config = {
                'applications': [],
                'poll_interval': 60,
                'api_endpoint': 'http://localhost:8080'
            }
        except json.JSONDecodeError as e:
            logger.error(f"Invalid config JSON: {e}")
            self.config = {'applications': [], 'poll_interval': 60}

    def manage_containers(self):
        for app in self.config.get('applications', []):
            name = app.get('name')
            image = app.get('image')

            if not name or not image:
                logger.warning(f"Skipping invalid app config: {app}")
                continue

            try:
                if self.docker.container_exists(name):
                    if not self.docker.container_running(name):
                        logger.info(f"Starting container {name}")
                        self.docker.start_container(name)
                else:
                    logger.info(f"Creating container {name}")
                    self.docker.create_and_run(
                        image,
                        name,
                        environment=app.get('environment', {}),
                        ports=app.get('ports', []),
                        volumes=app.get('volumes', []),
                        labels={
                            'io.stratura.managed': 'true',
                            'io.stratura.app.name': name
                        }
                    )
            except Exception as e:
                logger.error(f"Failed to manage container {name}: {e}")

    def check_updates(self):
        api_endpoint = self.config.get('api_endpoint')
        if not api_endpoint:
            return

        try:
            response = requests.get(
                f"{api_endpoint}/updates",
                timeout=10
            )
            if response.status_code == 200:
                updates = response.json()
                if updates.get('available'):
                    logger.info(f"Update available: {updates.get('version')}")
                    self.trigger_update(updates.get('version'))
        except requests.exceptions.RequestException as e:
            logger.debug(f"Update check failed: {e}")
        except Exception as e:
            logger.error(f"Update check error: {e}")

    def trigger_update(self, version: str):
        """Trigger system update - placeholder for RAUC integration"""
        logger.info(f"Update trigger for version {version} - not implemented")

    def save_state(self):
        """Save supervisor state"""
        state_dir = os.path.dirname(self.state_path)
        os.makedirs(state_dir, exist_ok=True)

        state = {
            'last_run': time.time(),
            'config_loaded': bool(self.config)
        }

        try:
            with open(self.state_path, 'w') as f:
                json.dump(state, f)
        except Exception as e:
            logger.error(f"Failed to save state: {e}")

    def run(self):
        logger.info("StraturaOS Supervisor starting...")

        while True:
            try:
                self.manage_containers()
                self.check_updates()
                self.save_state()

                interval = self.config.get('poll_interval', 60)
                time.sleep(interval)

            except KeyboardInterrupt:
                logger.info("Supervisor shutting down...")
                break
            except Exception as e:
                logger.error(f"Supervisor error: {e}")
                time.sleep(10)


if __name__ == "__main__":
    supervisor = StraturaSupervisor()
    supervisor.run()
