#!/usr/bin/env python3

import docker
import sys
import json
import logging

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger('supervisor-healthcheck')

def check_supervisor_health():
    try:
        client = docker.from_env()
        
        # Check Docker daemon
        client.ping()
        
        # Check supervisor container
        supervisor = client.containers.get('stratura-supervisor')
        if supervisor.status != 'running':
            return False
            
        # Check managed containers
        with open('/etc/stratura-supervisor/config.json', 'r') as f:
            config = json.load(f)
            
        for app in config['applications']:
            try:
                container = client.containers.get(app['name'])
                if container.status != 'running':
                    logger.error(f"Container {app['name']} is not running")
                    return False
            except docker.errors.NotFound:
                logger.error(f"Container {app['name']} not found")
                return False
                
        return True
        
    except Exception as e:
        logger.error(f"Health check failed: {e}")
        return False

if __name__ == "__main__":
    if check_supervisor_health():
        sys.exit(0)
    sys.exit(1) 