#!/usr/bin/env python3
"""
StraturaOS Supervisor Pre-start Check

This script runs before the supervisor starts to verify:
1. Docker daemon is accessible
2. Required directories exist

This is NOT a runtime healthcheck - it's a pre-flight check.
"""

import subprocess
import sys
import os
import logging

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger('supervisor-healthcheck')


def check_docker():
    """Check if Docker daemon is running and accessible"""
    try:
        result = subprocess.run(
            ['docker', 'info'],
            capture_output=True,
            text=True,
            timeout=30
        )
        if result.returncode == 0:
            logger.info("Docker daemon is running")
            return True
        else:
            logger.error(f"Docker not ready: {result.stderr}")
            return False
    except subprocess.TimeoutExpired:
        logger.error("Docker check timed out")
        return False
    except FileNotFoundError:
        logger.error("Docker CLI not found")
        return False
    except Exception as e:
        logger.error(f"Docker check failed: {e}")
        return False


def check_directories():
    """Check if required directories exist"""
    required_dirs = [
        '/var/lib/stratura-supervisor',
        '/etc/stratura'
    ]

    all_ok = True
    for dir_path in required_dirs:
        if os.path.isdir(dir_path):
            logger.info(f"Directory exists: {dir_path}")
        else:
            logger.warning(f"Directory missing: {dir_path}")
            # Try to create it
            try:
                os.makedirs(dir_path, exist_ok=True)
                logger.info(f"Created directory: {dir_path}")
            except Exception as e:
                logger.error(f"Failed to create {dir_path}: {e}")
                all_ok = False

    return all_ok


def main():
    """Run all pre-start checks"""
    logger.info("Running supervisor pre-start checks...")

    checks = [
        ("Docker daemon", check_docker),
        ("Required directories", check_directories),
    ]

    all_passed = True
    for name, check_func in checks:
        logger.info(f"Checking: {name}")
        if not check_func():
            logger.error(f"Check failed: {name}")
            all_passed = False

    if all_passed:
        logger.info("All pre-start checks passed")
        return 0
    else:
        logger.error("Some pre-start checks failed")
        return 1


if __name__ == "__main__":
    sys.exit(main())
