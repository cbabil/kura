#!/usr/bin/env python3
"""StraturaOS API Server launcher"""

import sys
sys.path.insert(0, '/usr/lib/stratura')

from api_server import app
import uvicorn

if __name__ == "__main__":
    uvicorn.run(
        app,
        host="0.0.0.0",
        port=48484,
        ssl_keyfile="/etc/stratura/certs/api.key",
        ssl_certfile="/etc/stratura/certs/api.crt"
    )
