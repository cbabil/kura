[Unit]
Description=StraturaOS API Server
After=network.target stratura-supervisor.service
Requires=stratura-supervisor.service

[Service]
Type=simple
Restart=always
RestartSec=10
ExecStart=/usr/bin/stratura-api
Environment=PYTHONPATH=/usr/lib/stratura

# Security hardening
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadOnlyPaths=/etc
ReadWritePaths=/var/lib/stratura

[Install]
WantedBy=multi-user.target
