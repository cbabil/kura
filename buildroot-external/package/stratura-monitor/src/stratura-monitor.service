[Unit]
Description=StraturaOS System Monitor
After=stratura-supervisor.service

[Service]
Type=simple
Restart=always
RestartSec=30
ExecStart=/usr/bin/stratura-monitor
Environment=PYTHONPATH=/usr/lib/stratura

# Security hardening
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadOnlyPaths=/etc

[Install]
WantedBy=multi-user.target
