#!/usr/bin/env python3

import json
import os
import subprocess
import sys
import time
import requests
import logging
from pathlib import Path

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger('stratura-updater')

class StraturaUpdater:
    def __init__(self):
        self.config_path = '/etc/stratura/config.json'
        self.state_path = '/var/lib/straturaOS/update-state.json'
        self.load_config()
        
    def load_config(self):
        with open(self.config_path, 'r') as f:
            self.config = json.load(f)
            
    def get_current_partition(self):
        result = subprocess.run(['rauc', 'status'], capture_output=True, text=True)
        return 'system-a' if 'system-a (active)' in result.stdout else 'system-b'

    def download_update(self, version):
        url = f"{self.config['update_server']}/v1/updates/{version}"
        response = requests.get(url, stream=True)
        
        if response.status_code == 200:
            update_file = f"/tmp/update-{version}.raucb"
            with open(update_file, 'wb') as f:
                for chunk in response.iter_content(chunk_size=8192):
                    f.write(chunk)
            return update_file
        return None

    def install_update(self, update_file):
        try:
            result = subprocess.run(['rauc', 'install', update_file], 
                                  capture_output=True, text=True)
            return result.returncode == 0
        except Exception as e:
            logger.error(f"Update installation failed: {e}")
            return False

    def run(self):
        while True:
            try:
                if self.config['updates']['strategy'] == 'download-then-update':
                    self.check_and_apply_updates()
                time.sleep(self.config['updates'].get('updatePoll', 300))
            except Exception as e:
                logger.error(f"Update client error: {e}")
                time.sleep(10)

if __name__ == "__main__":
    updater = StraturaUpdater()
    updater.run() 